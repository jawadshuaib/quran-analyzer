# Copy to .env and fill in. .env is gitignored.

# ElevenLabs API key — same one your existing pipeline uses.
# Find it at: Admin → Settings → ElevenLabs in the al-nuqta dashboard.
ELEVENLABS_API_KEY=

# Voice to narrate with. Defaults below match the existing
# admin_voices row ("Mark"). To use a different voice, look up the
# voice_id in your ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=FtySuiB8BjBKGfy1Zs7b

# Optional — defaults to eleven_multilingual_v2 (the model the
# existing pipeline uses). Override if you want to test a different
# model. The with-timestamps endpoint must support it.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Dev kill switch — set to 1 while iterating on visuals so we don't
# burn API credits regenerating audio for every tweak. Cached audio
# still plays from audio-cache/; cache misses render silently. Flip
# back to 0 (or remove) before a final render when fresh audio is
# wanted. Cheap insurance against accidental costly re-renders.
# ELEVENLABS_DISABLE_GENERATION=0
